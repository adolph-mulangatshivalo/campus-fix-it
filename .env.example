# ==============================================================================
# VERCEL ENVIRONMENT VARIABLES CHEATSHEET
# ==============================================================================
# Do not commit your actual keys here! This is just a checklist of the exact 
# variable names you need to add to your Vercel Dashboard -> Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. FIREBASE ADMIN SDK
# ------------------------------------------------------------------------------
# Go to Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# Paste the ENTIRE contents of the downloaded JSON file as the value.
FIREBASE_SERVICE_ACCOUNT=

# ------------------------------------------------------------------------------
# 2. EMAILJS (For Password Reset OTPs)
# ------------------------------------------------------------------------------
# From your new Official Campus Fix-It EmailJS account:
EMAILJS_SERVICE_ID=service_642hzss
EMAILJS_TEMPLATE_ID=template_zn7xwrk
EMAILJS_FIXED_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=9GCnZ9m-vNGyQTP8v

# You must also grab the PRIVATE KEY for the secure backend to work.
# Go to EmailJS Dashboard -> Account -> API Keys -> Private Key.
EMAILJS_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 3. IMGBB (For Image Uploads)
# ------------------------------------------------------------------------------
# This is the key used for the "image to webgl thing" (uploading report images).
# Go to https://api.imgbb.com/ to get your free API key.
IMGBB_API_KEY=870f42782e986d3190179675728d3e52
